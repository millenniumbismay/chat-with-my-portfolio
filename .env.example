# Server-only credentials. This file is safe to copy to .env; real .env values stay local.
# Owner, assistant, prompt, tone, provider, and models live in portfolio.config.json.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
OPENAI_API_KEY=
# Owner backend token (at least 32 characters); generate locally with npm run backend:init.
ADMIN_TOKEN=

# Optional server overrides; leave blank to use configured defaults.
LLM_PROVIDER=
CLOUDFLARE_AI_MODEL=
OPENAI_MODEL=
ALLOWED_ORIGIN=

# Public build-time API origin when using GitHub Pages (never a token).
PORTFOLIO_API_URL=
# Optional local preview port; default is 8888.
# PORT=8888
