{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieldnotes-portfolio",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "vars": {
    "LLM_PROVIDER": "cloudflare",
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "ALLOWED_ORIGIN": "",
  },
  "observability": {
    "enabled": false,
  },
}
