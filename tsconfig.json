{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*", "./*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "content/**/*.ts"],
  "exclude": ["node_modules", "dist", "preview", ".fieldnotes"]
}
