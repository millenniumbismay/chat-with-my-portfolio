{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio experience",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "endDate": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "required": ["id", "role", "organization", "startDate", "endDate", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["entries"],
  "additionalProperties": false
}
