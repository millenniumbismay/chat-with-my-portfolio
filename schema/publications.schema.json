{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio publications",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 100
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "sample": {
            "type": "boolean"
          }
        },
        "required": ["id", "title", "authors", "venue", "year", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["entries"],
  "additionalProperties": false
}
