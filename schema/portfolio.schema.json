{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fieldnotes portfolio configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "firstName": {
          "type": "string",
          "minLength": 1
        },
        "initials": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "bio": {
          "type": "string",
          "minLength": 1
        },
        "about": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "sample": {
          "type": "boolean"
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "firstName",
        "initials",
        "tagline",
        "bio",
        "about",
        "email",
        "github",
        "linkedin",
        "sample",
        "interests"
      ],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "showStudioLink": {
          "type": "boolean"
        }
      },
      "required": ["description", "showStudioLink"],
      "additionalProperties": false
    },
    "assistant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "starterQuestions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["name", "tagline", "role", "tone", "prompt", "behavior", "starterQuestions"],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            }
          },
          "required": ["enabled", "username"],
          "additionalProperties": false
        },
        "manual": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": ["enabled"],
          "additionalProperties": false
        }
      },
      "required": ["github", "manual"],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "workerName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "required": ["workerName", "allowedOrigins"],
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": ["cloudflare", "openai"]
        },
        "cloudflareModel": {
          "type": "string",
          "minLength": 1
        },
        "openaiModel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["provider", "cloudflareModel", "openaiModel"],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "profile",
    "site",
    "assistant",
    "sources",
    "deployment",
    "ai"
  ],
  "additionalProperties": false
}
